  "components": {
    "schemas": {
      "CreateCategoryDto": {
        "required": [
          "name",
          "sport"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "sport": {
            "minLength": 1,
            "pattern": "^(Running|Cycling|Walking)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateEnrolmentDto": {
        "required": [
          "eventID"
        ],
        "type": "object",
        "properties": {
          "eventID": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateEventDto": {
        "required": [
          "categoryID",
          "eventDate",
          "location",
          "name",
          "startTime"
        ],
        "type": "object",
        "properties": {
          "categoryID": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          },
          "location": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "route": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "minLength": 1,
            "type": "string"
          },
          "startTime": {
            "minLength": 1,
            "type": "string"
          },
          "maxParticipants": {
            "type": "integer",
            "format": "int32"
          },
          "entryFee": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateResultDto": {
        "required": [
          "enrolmentID",
          "finishTime"
        ],
        "type": "object",
        "properties": {
          "enrolmentID": {
            "type": "integer",
            "format": "int32"
          },
          "finishTime": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "position": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "notes": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "RegisterDto": {
        "required": [
          "email",
          "fullName",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
